{
  "name": "criscodev-dropi-product-analyzer",
  "version": "1.0.0",
  "description": "Módulo autónomo de investigación de catálogo, importación, auditoría y evaluación de productos de Dropi Chile",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "test": "tsx scripts/verify_services.ts && tsx --test tests/shipping_rates.test.ts && tsx --test tests/profitability.test.ts",
    "test:shipping": "tsx --test tests/shipping_rates.test.ts",
    "test:profitability": "tsx --test tests/profitability.test.ts",
    "seed": "tsx scripts/seed_and_test_excel.ts",
    "export": "tsx scripts/seed_and_test_excel.ts",
    "importer": "python importer/dropi_importer.py",
    "migrate": "tsx scripts/run_migrations.ts",
    "login": "tsx scripts/login_browser.ts"
  },
  "keywords": [
    "dropi",
    "dropi-chile",
    "catalog-analyzer",
    "ecommerce",
    "postgresql",
    "exceljs",
    "criscodev"
  ],
  "author": "CrisCodev",
  "license": "UNLICENSED",
  "dependencies": {
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "pg": "^8.13.1",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}