# Configuración del servidor independiente CrisCodev Dropi Analyzer
PORT=3005
NODE_ENV=development

# Conexión a Base de Datos PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/criscodev

# Parámetros individuales alternativos para PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=criscodev

# Token de sesión Dropi Chile o Clave de Integración
# (También configurable interactivamente desde la pantalla de conexión)
DROPI_TOKEN=
